# Fully synthetic Northstar local demo. No credentials are stored here.
RAG_ENVIRONMENT=development
RAG_AUTH_ENABLED=true
RAG_INGESTION_SOURCE_PATH=data/demo/source
RAG_DATABASE_PATH=data/private/knowledge.db
RAG_AUTH_USERS_FILE=data/private/demo-auth.json
RAG_AUTH_SESSION_DATABASE_PATH=data/private/demo-sessions.db
RAG_STAGING_PATH=data/private/staging
RAG_QDRANT_PATH=data/private/qdrant
RAG_QDRANT_COLLECTION=foreign_trade_demo
RAG_EMBEDDING_PROVIDER=domain_hash
RAG_EMBEDDING_DIM=384
RAG_EMBEDDING_ALLOW_HASH_FALLBACK=false
RAG_CHUNKING_STRATEGY=source_aware
RAG_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
RAG_RATE_LIMIT_ENABLED=true
# Optional real multilingual neural embeddings (downloads a public ONNX model):
# RAG_EMBEDDING_PROVIDER=fastembed
# RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RAG_EMBEDDING_CACHE_PATH=data/private/models
