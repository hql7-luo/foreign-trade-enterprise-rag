# Template only: TLS/domain/volumes must be provisioned before public exposure.
# No paid production deployment is running.
RAG_ENVIRONMENT=production
RAG_PUBLIC_ORIGIN=https://demo.example.invalid
RAG_ALLOWED_HOSTS=demo.example.invalid,backend,localhost,127.0.0.1
RAG_DEMO_MODE=true
RAG_PUBLIC_DEMO_READ_ONLY=true
RAG_RATE_LIMIT_ENABLED=true
RAG_AUTH_ENABLED=true
RAG_ENABLE_DOCS=false
RAG_DEBUG=false
RAG_RUNTIME_ROOT=/app/data/public-demo-runtime
RAG_DATABASE_PATH=/app/data/public-demo-runtime/knowledge.db
RAG_AUTH_USERS_FILE=/app/data/public-demo-runtime/demo-auth.json
RAG_AUTH_SESSION_DATABASE_PATH=/app/data/public-demo-runtime/demo-sessions.db
RAG_STAGING_PATH=/app/data/public-demo-runtime/staging
RAG_EMBEDDING_CACHE_PATH=/app/data/public-demo-runtime/models
RAG_RERANKER_CACHE_PATH=/app/data/public-demo-runtime/models
RAG_INGESTION_SOURCE_PATH=/app/data/demo/source
RAG_QDRANT_URL=http://qdrant:6333
RAG_QDRANT_COLLECTION=public_demo_northstar
# Generate separately and configure the matching Qdrant server key. Required, intentionally blank.
RAG_QDRANT_API_KEY=
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DIM=384
RAG_EMBEDDING_ALLOW_HASH_FALLBACK=false
RAG_CHUNKING_STRATEGY=source_aware
